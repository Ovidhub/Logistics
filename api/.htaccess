RewriteEngine On

# Never let LiteSpeed/proxy cache the dynamic API (responses vary per request).
<IfModule LiteSpeed>
CacheDisable public /
</IfModule>

# Make the Authorization header available to PHP (some hosts strip it).
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Route everything that is not a real file/dir to the front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
